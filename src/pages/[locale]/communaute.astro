---
import CommunitySection from '../../components/CommunitySection.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../lib/i18n';

export const prerender = true;
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const translations = locales.map((item) => ({ locale: item, href: `/${item}/communaute/` }));
const pageTranslations: Partial<
  Record<
    Locale,
    {
      title: string;
      description: string;
      kicker: string;
      join: string;
      charterLink: string;
      activitiesKicker: string;
      activitiesTitle: string;
      activities: string[][];
      charterKicker: string;
      charterTitle: string;
      charter: string[];
      newsletterTitle: string;
      newsletterText: string;
    }
  >
> = {
  fr: {
    title: 'Communauté',
    description:
      'Un espace critique et solidaire pour discuter des jeux, tester les prototypes, lire et partager des ressources.',
    kicker: 'Discord · Tests · Lecture',
    join: 'Rejoindre le Discord',
    charterLink: 'Lire la charte',
    activitiesKicker: 'Ce qu’on y fait',
    activitiesTitle: 'Un atelier public, pas un flux de plus.',
    activities: [
      [
        'Discuter',
        'Analyse de jeux, actualités des projets et débats sur les rapports entre jeu vidéo, histoire et politique.',
      ],
      [
        'Tester',
        'Versions de travail, appels à test et retours structurés pour améliorer les mécaniques et l’accessibilité.',
      ],
      [
        'Lire',
        'Cercles de lecture ponctuels et bibliographies partagées autour du marxisme, de l’histoire et du game design.',
      ],
      [
        'Construire',
        'Propositions de ressources, traductions, recherches et événements portés avec les membres.',
      ],
    ],
    charterKicker: 'Charte courte',
    charterTitle: 'Critique exigeante. Accueil solidaire.',
    charter: [
      'Nous discutons les idées et les œuvres sans humilier les personnes. Racisme, sexisme, LGBTphobies, validisme, harcèlement et promotion de mouvements réactionnaires n’ont pas leur place dans la communauté.',
      'Les retours de test portent sur une expérience concrète : ce que vous avez compris, ressenti ou tenté. La contradiction est bienvenue lorsqu’elle aide à travailler.',
      'Une charte de modération complète et les coordonnées de l’équipe sont à valider avant l’ouverture publique.',
    ],
    newsletterTitle: 'Suivre sans rejoindre Discord.',
    newsletterText:
      'La newsletter est la voie calme : nouvelles importantes, sorties et appels à test.',
  },
  en: {
    title: 'Community',
    description:
      'A critical, supportive space to discuss games, test prototypes, read and share resources.',
    kicker: 'Discord · Tests · Reading',
    join: 'Join Discord',
    charterLink: 'Read the charter',
    activitiesKicker: 'What happens there',
    activitiesTitle: 'A public workshop, not another feed.',
    activities: [
      ['Discuss', 'Game analysis, project news and debates about games, history and politics.'],
      ['Test', 'Work-in-progress builds, playtests and structured feedback.'],
      ['Read', 'Reading groups and shared bibliographies on Marxism, history and game design.'],
      ['Build', 'Resources, translations, research and events created with members.'],
    ],
    charterKicker: 'Short charter',
    charterTitle: 'Rigorous criticism. Supportive welcome.',
    charter: [
      'We discuss ideas and works without humiliating people. Racism, sexism, LGBTphobia, ableism, harassment and the promotion of reactionary movements have no place in the community.',
      'Playtest feedback should describe a concrete experience: what you understood, felt or tried. Disagreement is welcome when it helps the work.',
      'A full moderation charter and team contacts must be approved before public launch.',
    ],
    newsletterTitle: 'Follow without joining Discord.',
    newsletterText: 'The newsletter is the quieter route: important news, releases and playtests.',
  },
  nl: {
    title: 'Gemeenschap',
    description:
      'Een kritische en solidaire plek om spellen te bespreken, prototypes te testen, te lezen en bronnen te delen.',
    kicker: 'Discord · Tests · Lezen',
    join: 'Naar Discord',
    charterLink: 'Lees het handvest',
    activitiesKicker: 'Wat we er doen',
    activitiesTitle: 'Een openbaar atelier, geen extra berichtenstroom.',
    activities: [
      [
        'Bespreken',
        'Spelanalyses, projectnieuws en debatten over spellen, geschiedenis en politiek.',
      ],
      ['Testen', 'Werkversies, speeltests en gestructureerde feedback.'],
      [
        'Lezen',
        'Leesgroepen en gedeelde bibliografieën over marxisme, geschiedenis en game design.',
      ],
      ['Bouwen', 'Bronnen, vertalingen, onderzoek en evenementen die we met leden maken.'],
    ],
    charterKicker: 'Kort handvest',
    charterTitle: 'Grondige kritiek. Solidaire ontvangst.',
    charter: [
      'We bespreken ideeën en werken zonder mensen te vernederen. Racisme, seksisme, lhbti-fobie, validisme, intimidatie en de promotie van reactionaire bewegingen horen niet thuis in de gemeenschap.',
      'Feedback op speeltests gaat over een concrete ervaring: wat je begreep, voelde of probeerde. Meningsverschillen zijn welkom wanneer ze het werk vooruithelpen.',
      'Een volledig moderatiehandvest en de contactgegevens van het team moeten vóór de publieke lancering worden goedgekeurd.',
    ],
    newsletterTitle: 'Volg ons zonder lid te worden van Discord.',
    newsletterText:
      'De nieuwsbrief is de rustige route: belangrijk nieuws, releases en oproepen voor speeltests.',
  },
  it: {
    title: 'Comunità',
    description:
      'Uno spazio critico e solidale per discutere di giochi, testare prototipi, leggere e condividere risorse.',
    kicker: 'Discord · Test · Lettura',
    join: 'Unisciti a Discord',
    charterLink: 'Leggi la carta',
    activitiesKicker: 'Cosa facciamo',
    activitiesTitle: 'Un laboratorio pubblico, non un altro flusso.',
    activities: [
      [
        'Discutere',
        'Analisi di giochi, notizie sui progetti e dibattiti su giochi, storia e politica.',
      ],
      ['Testare', 'Versioni in lavorazione, playtest e feedback strutturati.'],
      ['Leggere', 'Gruppi di lettura e bibliografie condivise su marxismo, storia e game design.'],
      ['Costruire', 'Risorse, traduzioni, ricerche ed eventi creati insieme ai membri.'],
    ],
    charterKicker: 'Carta breve',
    charterTitle: 'Critica rigorosa. Accoglienza solidale.',
    charter: [
      'Discutiamo idee e opere senza umiliare le persone. Razzismo, sessismo, LGBTfobia, abilismo, molestie e promozione di movimenti reazionari non hanno posto nella comunità.',
      'I feedback dei playtest devono descrivere un’esperienza concreta: ciò che hai capito, provato o tentato. Il dissenso è benvenuto quando aiuta il lavoro.',
      'Una carta di moderazione completa e i contatti del gruppo devono essere approvati prima dell’apertura pubblica.',
    ],
    newsletterTitle: 'Seguici senza entrare su Discord.',
    newsletterText:
      'La newsletter è la via più tranquilla: notizie importanti, uscite e inviti ai playtest.',
  },
};
const copy = pageTranslations[locale] ?? pageTranslations.en!;
const { title, description, activities } = copy;
---

<BaseLayout {title} {description} {locale} translationLinks={translations}>
  <header class="page-hero">
    <div class="container page-hero__inner">
      <p class="section-kicker">{copy.kicker}</p><h1>{title}</h1><p>
        {description}
      </p><div class="button-row">
        <a class="button button--cream" href="https://discord.gg/placeholder">{copy.join} ↗</a><a
          class="button button--ghost"
          href="#charte">{copy.charterLink} ↓</a
        >
      </div>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <header class="section-heading">
        <p class="section-kicker">{copy.activitiesKicker}</p><h2>{copy.activitiesTitle}</h2>
      </header><div class="activity-grid">
        {
          activities.map(([title, text], index) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section id="charte" class="section section--dark">
    <div class="container charter">
      <header>
        <p class="section-kicker">{copy.charterKicker}</p><h2>{copy.charterTitle}</h2>
      </header><div class="prose">
        <p>{copy.charter[0]}</p><p>{copy.charter[1]}</p><p class="notice">
          {copy.charter[2]}
        </p>
      </div>
    </div>
  </section>
  <CommunitySection {locale} />
  <section class="section">
    <div class="container newsletter-grid">
      <div>
        <p class="section-kicker">Newsletter</p><h2>{copy.newsletterTitle}</h2><p>
          {copy.newsletterText}
        </p>
      </div><NewsletterForm {locale} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero .button--ghost {
    border-color: var(--color-dark-red);
    color: var(--color-dark-red);
    background: var(--color-cream);
  }
  .activity-grid {
    display: grid;
    gap: var(--space-4);
  }
  .activity-grid article {
    display: grid;
    gap: var(--space-3);
    min-height: 16rem;
    align-content: end;
    padding: var(--space-4);
    border: 0.12rem solid var(--color-black);
    background: var(--color-cream);
  }
  .activity-grid span {
    color: var(--color-red);
    font-size: 0.7rem;
    font-weight: 900;
  }
  .activity-grid p {
    color: var(--color-gray);
  }
  .charter,
  .newsletter-grid {
    display: grid;
    gap: var(--space-6);
  }
  .charter header,
  .newsletter-grid > div {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .newsletter-grid > div > p:last-child {
    color: var(--color-gray);
    font-size: var(--step-1);
  }
  @media (min-width: 48rem) {
    .activity-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .charter,
    .newsletter-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
</style>
