---
import { getCollection } from 'astro:content';
import ArticleCard from '../../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categoryLabels, locales, type Locale } from '../../../../lib/i18n';

export const prerender = true;
export function getStaticPaths() {
  const categories = Object.keys(categoryLabels.fr);
  return locales.flatMap((locale) =>
    categories.map((category) => ({ params: { locale, category } })),
  );
}
const locale = Astro.params.locale as Locale;
const category = Astro.params.category!;
const label = categoryLabels[locale][category] ?? category;
const articles = (
  await getCollection(
    'articles',
    ({ data }) => data.locale === locale && data.category === category && !data.draft,
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const description = `${label} — Marxists Games`;
const translations = locales.map((item) => ({
  locale: item,
  href: `/${item}/articles/categories/${category}/`,
}));
const pageTranslations: Partial<
  Record<
    Locale,
    {
      home: string;
      category: string;
      count: (count: number) => string;
      empty: string;
    }
  >
> = {
  fr: {
    home: 'Accueil',
    category: 'Catégorie',
    count: (count) => `${count} article${count > 1 ? 's' : ''} publié${count > 1 ? 's' : ''}.`,
    empty: 'Aucun article publié dans cette catégorie et cette langue.',
  },
  en: {
    home: 'Home',
    category: 'Category',
    count: (count) => `${count} published article${count === 1 ? '' : 's'}.`,
    empty: 'No article is published in this category and language.',
  },
  nl: {
    home: 'Home',
    category: 'Categorie',
    count: (count) => `${count} gepubliceerd${count === 1 ? ' artikel' : 'e artikelen'}.`,
    empty: 'Er is geen artikel gepubliceerd in deze categorie en taal.',
  },
  it: {
    home: 'Home',
    category: 'Categoria',
    count: (count) => `${count} articol${count === 1 ? 'o pubblicato' : 'i pubblicati'}.`,
    empty: 'Non è stato pubblicato alcun articolo in questa categoria e lingua.',
  },
};
const copy = pageTranslations[locale] ?? pageTranslations.en!;
---

<BaseLayout title={label} {description} {locale} translationLinks={translations}>
  <Breadcrumbs
    items={[
      { label: copy.home, href: `/${locale}/` },
      { label: 'Articles', href: `/${locale}/articles/` },
      { label },
    ]}
  />
  <header class="page-hero">
    <div class="container page-hero__inner">
      <p class="section-kicker">{copy.category}</p><h1>{label}</h1><p>
        {copy.count(articles.length)}
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      {
        articles.length > 0 ? (
          <div class="grid-3">
            {articles.map((article) => (
              <ArticleCard {article} {locale} />
            ))}
          </div>
        ) : (
          <div class="notice">
            <>
              <p>{copy.empty}</p>
              <a href={`/${locale}/articles/`}>← Articles</a>
            </>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
