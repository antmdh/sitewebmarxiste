---
import { getCollection } from 'astro:content';
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabels, locales, type Locale } from '../../../lib/i18n';

export const prerender = true;
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const articles = (
  await getCollection('articles', ({ data }) => data.locale === locale && !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const copy: Record<
  Locale,
  {
    kicker: string;
    title: string;
    description: string;
    categories: string;
    empty: string;
    french: string;
  }
> = {
  fr: {
    kicker: 'Magazine culturel',
    title: 'Articles & réflexions',
    description:
      'Journaux de développement, jeux marxistes à découvrir, histoire, tutoriels et réflexions sur le jeu vidéo.',
    categories: 'Catégories d’articles',
    empty: 'Aucun article publié dans cette langue.',
    french: 'Consulter les articles en français',
  },
  en: {
    kicker: 'Cultural magazine',
    title: 'Articles & essays',
    description:
      'Development journals, Marxist games, history, tutorials and essays on video games.',
    categories: 'Article categories',
    empty: 'No article is published in this language yet.',
    french: 'Read the articles in French',
  },
  es: {
    kicker: 'Revista cultural',
    title: 'Artículos y reflexiones',
    description:
      'Diarios de desarrollo, juegos marxistas, historia, tutoriales y reflexiones sobre videojuegos.',
    categories: 'Categorías de artículos',
    empty: 'Todavía no hay artículos publicados en este idioma.',
    french: 'Consultar los artículos en francés',
  },
  de: {
    kicker: 'Kulturmagazin',
    title: 'Artikel & Essays',
    description:
      'Entwicklungstagebücher, marxistische Spiele, Geschichte, Tutorials und Essays über Videospiele.',
    categories: 'Artikelkategorien',
    empty: 'In dieser Sprache ist noch kein Artikel veröffentlicht.',
    french: 'Artikel auf Französisch lesen',
  },
  nl: {
    kicker: 'Cultureel magazine',
    title: 'Artikelen & beschouwingen',
    description:
      'Ontwikkelingsdagboeken, marxistische spellen, geschiedenis, handleidingen en beschouwingen over videogames.',
    categories: 'Artikelcategorieën',
    empty: 'Er is nog geen artikel in deze taal gepubliceerd.',
    french: 'Lees de artikelen in het Frans',
  },
  it: {
    kicker: 'Rivista culturale',
    title: 'Articoli & riflessioni',
    description:
      'Diari di sviluppo, giochi marxisti, storia, tutorial e riflessioni sui videogiochi.',
    categories: 'Categorie degli articoli',
    empty: 'Non è ancora stato pubblicato alcun articolo in questa lingua.',
    french: 'Leggi gli articoli in francese',
  },
};
const { kicker, title, description, categories: categoriesLabel, empty, french } = copy[locale];
const translations = locales.map((item) => ({ locale: item, href: `/${item}/articles/` }));
const categories = Object.entries(categoryLabels[locale]);
---

<BaseLayout {title} {description} {locale} translationLinks={translations}>
  <header class="page-hero">
    <div class="container page-hero__inner">
      <p class="section-kicker">{kicker}</p><h1>{title}</h1><p>{description}</p>
    </div>
  </header>
  <nav class="category-nav" aria-label={categoriesLabel}>
    <div class="container">
      <ul class="no-list">
        {
          categories.map(([slug, label]) => (
            <li>
              <a href={`/${locale}/articles/categories/${slug}/`}>{label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
  <section class="section">
    <div class="container">
      {
        articles.length > 0 ? (
          <div class="grid-3">
            {articles.map((article) => (
              <ArticleCard {article} {locale} />
            ))}
          </div>
        ) : (
          <div class="notice">
            <>
              <p>{empty}</p>
              <a href="/fr/articles/">{french} →</a>
            </>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .category-nav {
    overflow-x: auto;
    border-bottom: 0.22rem solid var(--color-black);
    background: var(--color-cream);
  }
  .category-nav ul {
    display: flex;
    width: max-content;
    gap: 0.5rem;
    padding-block: var(--space-3);
  }
  .category-nav a {
    display: block;
    padding: 0.5rem 0.7rem;
    border: 0.14rem solid var(--color-black);
    box-shadow: 0.14rem 0.14rem 0 var(--color-dark-red);
    font-size: 0.72rem;
    font-weight: 850;
    text-decoration: none;
    text-transform: uppercase;
  }
  .category-nav a:hover {
    color: var(--color-white);
    background: var(--color-red);
  }
</style>
