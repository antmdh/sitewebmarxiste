---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedDate, type Locale } from '../../../lib/i18n';

export const prerender = true;
export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);
  return games.map((game) => ({
    params: { locale: game.data.locale, slug: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const locale = Astro.params.locale as Locale;
const { Content } = await render(game);
const allGames = await getCollection('games', ({ data }) => !data.draft);
const translations = allGames
  .filter(({ data }) => data.translationKey === game.data.translationKey)
  .map(({ data }) => ({ locale: data.locale, href: `/${data.locale}/jeux/${data.slug}/` }));
const articles = (
  await getCollection(
    'articles',
    ({ data }) =>
      data.locale === locale && data.relatedGame === game.data.translationKey && !data.draft,
  )
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.data.title,
  description: game.data.description,
  gamePlatform: game.data.platforms,
  genre: game.data.genre,
  inLanguage: locale,
  image: new URL(game.data.heroImage.src, Astro.site).href,
  author: { '@type': 'Organization', name: 'Marxists Games' },
};
const detailTranslations: Partial<
  Record<
    Locale,
    {
      home: string;
      games: string;
      status: string;
      platforms: string;
      period: string;
      updated: string;
      project: string;
      projectTitle: string;
      gallery: string;
      galleryTitle: string;
      ctaKicker: string;
      ctaTitle: string;
      joinDiscord: string;
      readJournal: string;
      updates: string;
      journalTitle: string;
    }
  >
> = {
  fr: {
    home: 'Accueil',
    games: 'Jeux',
    status: 'Statut',
    platforms: 'Plateformes',
    period: 'Période',
    updated: 'Mise à jour',
    project: 'Le projet',
    projectTitle: 'Stratégie, contexte et choix.',
    gallery: 'Galerie',
    galleryTitle: 'Le jeu en images.',
    ctaKicker: 'Tests · discussions · histoire',
    ctaTitle: 'Suivez le développement avec nous.',
    joinDiscord: 'Rejoindre le Discord',
    readJournal: 'Lire le journal',
    updates: 'Dernières mises à jour',
    journalTitle: 'Dans le journal.',
  },
  en: {
    home: 'Home',
    games: 'Games',
    status: 'Status',
    platforms: 'Platforms',
    period: 'Period',
    updated: 'Updated',
    project: 'The project',
    projectTitle: 'Strategy, context and choices.',
    gallery: 'Gallery',
    galleryTitle: 'The game in images.',
    ctaKicker: 'Tests · discussions · history',
    ctaTitle: 'Follow development with us.',
    joinDiscord: 'Join Discord',
    readJournal: 'Read the journal',
    updates: 'Latest updates',
    journalTitle: 'From the journal.',
  },
  nl: {
    home: 'Home',
    games: 'Spellen',
    status: 'Status',
    platforms: 'Platformen',
    period: 'Periode',
    updated: 'Bijgewerkt',
    project: 'Het project',
    projectTitle: 'Strategie, context en keuzes.',
    gallery: 'Galerij',
    galleryTitle: 'Het spel in beeld.',
    ctaKicker: 'Tests · gesprekken · geschiedenis',
    ctaTitle: 'Volg de ontwikkeling samen met ons.',
    joinDiscord: 'Naar Discord',
    readJournal: 'Lees het dagboek',
    updates: 'Laatste updates',
    journalTitle: 'Uit het dagboek.',
  },
  it: {
    home: 'Home',
    games: 'Giochi',
    status: 'Stato',
    platforms: 'Piattaforme',
    period: 'Periodo',
    updated: 'Aggiornato',
    project: 'Il progetto',
    projectTitle: 'Strategia, contesto e scelte.',
    gallery: 'Galleria',
    galleryTitle: 'Il gioco in immagini.',
    ctaKicker: 'Test · discussioni · storia',
    ctaTitle: 'Segui lo sviluppo insieme a noi.',
    joinDiscord: 'Unisciti a Discord',
    readJournal: 'Leggi il diario',
    updates: 'Ultimi aggiornamenti',
    journalTitle: 'Dal diario.',
  },
};
const detail = detailTranslations[locale] ?? detailTranslations.en!;
---

<BaseLayout
  title={game.data.title}
  description={game.data.description}
  {locale}
  image={game.data.heroImage}
  translationLinks={translations}
  {structuredData}
>
  <Breadcrumbs
    items={[
      { label: detail.home, href: `/${locale}/` },
      { label: detail.games, href: `/${locale}/jeux/` },
      { label: game.data.title },
    ]}
  />
  <article>
    <header class="game-hero">
      <div class="container game-hero__grid">
        <div class="game-hero__copy">
          <p class="section-kicker">{game.data.genre}</p><h1>{game.data.title}</h1><p
            class="game-hero__subtitle"
          >
            {game.data.subtitle}
          </p><p>{game.data.description}</p><div class="button-row">
            {
              game.data.downloadUrl ? (
                <a class="button" href={game.data.downloadUrl}>
                  {game.data.ctaLabel}
                </a>
              ) : (
                <a class="button" href={game.data.devlogUrl ?? `/${locale}/articles/`}>
                  {game.data.ctaLabel}
                </a>
              )
            }<a class="button button--ghost" href="https://discord.gg/placeholder">Discord ↗</a>
          </div>
        </div>
        <figure>
          <Image
            src={game.data.heroImage}
            alt={game.data.heroAlt}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 60rem) 52vw, 100vw"
            format="webp"
            loading="eager"
          /><figcaption>{game.data.heroAlt}</figcaption>
        </figure>
      </div>
    </header>

    <section class="game-facts">
      <div class="container game-facts__grid">
        <div>
          <span>{detail.status}</span><strong>{game.data.developmentStatus}</strong>
        </div>
        <div>
          <span>{detail.platforms}</span><strong>{game.data.platforms.join(' · ')}</strong>
        </div>
        <div>
          <span>{detail.period}</span><strong>{game.data.historicalPeriod}</strong>
        </div>
        <div>
          <span>{detail.updated}</span><strong>{localizedDate(game.data.updatedAt, locale)}</strong>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container content-grid">
        <aside>
          <p class="section-kicker">{detail.project}</p><h2>{detail.projectTitle}</h2>
        </aside><div class="prose"><Content /></div>
      </div>
    </section>

    {
      game.data.gallery.length > 0 && (
        <section class="section gallery section--dark">
          <div class="container">
            <>
              <header class="section-heading">
                <>
                  <p class="section-kicker">{detail.gallery}</p>
                  <h2>{detail.galleryTitle}</h2>
                </>
              </header>
              <div class="gallery__grid">
                {game.data.gallery.map((item) => (
                  <figure>
                    <Image
                      src={item.image}
                      alt={item.alt}
                      widths={[720, 1200]}
                      sizes="(min-width: 50rem) 70vw, 100vw"
                      format="webp"
                      loading="lazy"
                    />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </>
          </div>
        </section>
      )
    }

    <section class="game-cta section section--red">
      <div class="container">
        <p class="section-kicker">{detail.ctaKicker}</p><h2>{detail.ctaTitle}</h2><div
          class="button-row"
        >
          <a class="button button--cream" href="https://discord.gg/placeholder"
            >{detail.joinDiscord} ↗</a
          >{
            game.data.devlogUrl && (
              <a class="button button--ghost" href={game.data.devlogUrl}>
                {detail.readJournal} →
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      articles.length > 0 && (
        <section class="section">
          <div class="container">
            <>
              <header class="section-heading">
                <>
                  <p class="section-kicker">{detail.updates}</p>
                  <h2>{detail.journalTitle}</h2>
                </>
              </header>
              <div class="grid-3">
                {articles.map((article) => (
                  <ArticleCard {article} {locale} />
                ))}
              </div>
            </>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .game-hero {
    color: var(--color-paper);
    background: var(--color-black);
  }
  .game-hero__grid {
    display: grid;
  }
  .game-hero__copy {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .game-hero__copy > p:not(.section-kicker) {
    max-width: 42rem;
    color: var(--color-paper-deep);
  }
  .game-hero__subtitle {
    color: var(--color-white) !important;
    font-size: var(--step-1);
    font-weight: 750;
  }
  .game-hero .button--ghost {
    border-color: var(--color-cream);
    color: var(--color-cream);
    background: transparent;
  }
  .game-hero figure {
    position: relative;
    min-width: 0;
    margin-right: -1rem;
  }
  .game-hero figure :global(img) {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
    border-inline: 0.22rem solid var(--color-black);
    filter: contrast(1.06) saturate(0.88);
    image-rendering: pixelated;
  }
  .game-hero figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 22rem;
    padding: 0.5rem;
    background: var(--color-black);
    font-size: 0.65rem;
  }
  .game-facts {
    color: var(--color-white);
    background: var(--color-red);
  }
  .game-facts__grid {
    display: grid;
  }
  .game-facts__grid > div {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3);
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
  }
  .game-facts span {
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .game-facts strong {
    line-height: 1.3;
  }
  .content-grid {
    display: grid;
    gap: var(--space-6);
  }
  .content-grid aside {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .gallery__grid figure {
    max-width: 62rem;
    margin-inline: auto;
  }
  .gallery__grid :global(img) {
    width: 100%;
    border: 0.22rem solid var(--color-cream);
    box-shadow: 0.35rem 0.35rem 0 var(--color-red);
    image-rendering: pixelated;
  }
  .gallery figcaption {
    padding-top: var(--space-2);
    color: var(--color-paper-deep);
    font-size: var(--step--1);
  }
  .game-cta h2 {
    max-width: 17ch;
    margin-bottom: var(--space-5);
  }
  .game-cta .button--ghost {
    border-color: var(--color-cream);
    color: var(--color-cream);
    background: transparent;
  }
  @media (min-width: 44rem) {
    .game-facts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .game-facts__grid > div {
      border-right: 1px solid rgb(255 255 255 / 0.3);
    }
  }
  @media (min-width: 60rem) {
    .game-hero__grid {
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 42rem;
    }
    .game-hero__copy {
      align-content: center;
      padding-right: var(--space-5);
    }
    .game-hero figure {
      margin-right: calc((100vw - min(100vw - 3rem, var(--max-width))) / -2);
    }
    .game-facts__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .content-grid {
      grid-template-columns: 0.7fr 1.3fr;
    }
    .content-grid aside {
      position: sticky;
      top: var(--space-4);
    }
  }
</style>
