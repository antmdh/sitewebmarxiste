---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../lib/i18n';

export const prerender = true;
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const translations = locales.map((item) => ({ locale: item, href: `/${item}/confidentialite/` }));
const pageTranslations: Partial<
  Record<
    Locale,
    {
      title: string;
      description: string;
      kicker: string;
      intro: string;
      collected: string;
      collectedText: string;
      retention: string;
      retentionText: string;
      rights: string;
      rightsText: string;
      warning: string;
      warningText: string;
    }
  >
> = {
  fr: {
    title: 'Confidentialité',
    description: 'Comment Marxist Games traite les données transmises par ses formulaires.',
    kicker: 'Données personnelles',
    intro:
      'Les informations envoyées via les formulaires de contact sont utilisées uniquement pour répondre à votre demande. L’adresse fournie au formulaire de newsletter est utilisée uniquement pour gérer votre inscription et vous envoyer les nouvelles de Marxist Games. La base juridique est votre consentement et, lorsqu’un projet est discuté, l’exécution de mesures précontractuelles.',
    collected: 'Données collectées',
    collectedText:
      'Pour la newsletter : adresse e-mail, langue, date et version du consentement, source et statut de l’inscription. Pour les demandes de contact : nom, organisation éventuelle, adresse e-mail et informations que vous choisissez de fournir. Le champ anti-spam, l’heure de début du formulaire et le contrôle Turnstile servent uniquement à limiter les envois automatisés.',
    retention: 'Durée et destinataires',
    retentionText:
      'L’adresse de newsletter est conservée jusqu’au retrait de votre consentement. Les données sont accessibles uniquement à l’équipe autorisée de Marxist Games, stockées dans un tableur Google privé et, pour l’envoi, traitées par le futur prestataire d’e-mail.',
    rights: 'Vos droits',
    rightsText:
      'Vous pouvez demander l’accès, la rectification ou la suppression de vos données, ainsi que retirer votre consentement, en écrivant à marxismepourdebutant@gmail.com.',
    warning: 'Protection des inscriptions',
    warningText:
      'Les identifiants Google restent côté serveur, le tableur n’est pas public et les envois sont protégés par Turnstile et une limitation de fréquence. Aucune adresse IP n’est enregistrée dans le tableur.',
  },
  en: {
    title: 'Privacy',
    description: 'How Marxist Games handles data submitted through its forms.',
    kicker: 'Personal data',
    intro:
      'Information sent through contact forms is used only to answer your request. The address submitted through the newsletter form is used only to manage your subscription and send Marxist Games news. The legal basis is consent and, when discussing a project, pre-contractual steps.',
    collected: 'Data collected',
    collectedText:
      'For the newsletter: email address, language, consent date and version, source and subscription status. For contact requests: name, optional organisation, email address and information you choose to provide. The anti-spam field, form start time and Turnstile check are used only to limit automated submissions.',
    retention: 'Retention and recipients',
    retentionText:
      'The newsletter address is retained until you withdraw consent. Data is available only to authorised Marxist Games team members, stored in a private Google spreadsheet and, for delivery, processed by the future email provider.',
    rights: 'Your rights',
    rightsText:
      'You can request access, correction or deletion of your data, and withdraw consent, by writing to marxismepourdebutant@gmail.com.',
    warning: 'Subscription security',
    warningText:
      'Google credentials remain server-side, the spreadsheet is not public, and submissions are protected by Turnstile and rate limiting. No IP address is stored in the spreadsheet.',
  },
  es: {
    title: 'Privacidad',
    description: 'Cómo trata Marxist Games los datos enviados a través de sus formularios.',
    kicker: 'Datos personales',
    intro:
      'La información enviada mediante los formularios de contacto se utiliza únicamente para responder a tu solicitud. La dirección enviada mediante el formulario de newsletter se utiliza únicamente para gestionar tu suscripción y enviarte noticias de Marxist Games. La base jurídica es el consentimiento y, cuando se habla de un proyecto, las medidas precontractuales.',
    collected: 'Datos recopilados',
    collectedText:
      'Para la newsletter: dirección de correo, idioma, fecha y versión del consentimiento, origen y estado de la suscripción. Para las solicitudes de contacto: nombre, organización opcional, correo e información que decidas facilitar. El campo antispam, la hora de inicio y el control Turnstile solo sirven para limitar los envíos automatizados.',
    retention: 'Conservación y destinatarios',
    retentionText:
      'La dirección de la newsletter se conserva hasta que retires tu consentimiento. Los datos solo son accesibles para el equipo autorizado de Marxist Games, se guardan en una hoja de cálculo privada de Google y, para el envío, serán tratados por el futuro proveedor de correo.',
    rights: 'Tus derechos',
    rightsText:
      'Puedes solicitar acceso, rectificación o supresión de tus datos y retirar tu consentimiento escribiendo a marxismepourdebutant@gmail.com.',
    warning: 'Protección de las suscripciones',
    warningText:
      'Las credenciales de Google permanecen en el servidor, la hoja de cálculo no es pública y los envíos están protegidos por Turnstile y una limitación de frecuencia. No se guarda ninguna dirección IP en la hoja.',
  },
  de: {
    title: 'Datenschutz',
    description: 'Wie Marxist Games mit Daten umgeht, die über Formulare übermittelt werden.',
    kicker: 'Personenbezogene Daten',
    intro:
      'Informationen aus Kontaktformularen werden ausschließlich zur Beantwortung deiner Anfrage verwendet. Die im Newsletter-Formular angegebene Adresse wird nur zur Verwaltung deiner Anmeldung und zum Versand von Nachrichten von Marxist Games verwendet. Rechtsgrundlage sind deine Einwilligung und bei Projektgesprächen vorvertragliche Maßnahmen.',
    collected: 'Erhobene Daten',
    collectedText:
      'Für den Newsletter: E-Mail-Adresse, Sprache, Datum und Version der Einwilligung, Quelle und Anmeldestatus. Für Kontaktanfragen: Name, optionale Organisation, E-Mail-Adresse und freiwillig bereitgestellte Informationen. Antispam-Feld, Startzeit und Turnstile-Prüfung dienen nur der Begrenzung automatisierter Einsendungen.',
    retention: 'Speicherdauer und Empfänger',
    retentionText:
      'Die Newsletter-Adresse wird bis zum Widerruf deiner Einwilligung gespeichert. Die Daten sind nur für autorisierte Mitglieder von Marxist Games zugänglich, werden in einer privaten Google-Tabelle gespeichert und für den Versand vom künftigen E-Mail-Anbieter verarbeitet.',
    rights: 'Deine Rechte',
    rightsText:
      'Du kannst Auskunft, Berichtigung oder Löschung deiner Daten verlangen und deine Einwilligung widerrufen, indem du an marxismepourdebutant@gmail.com schreibst.',
    warning: 'Schutz der Anmeldungen',
    warningText:
      'Google-Zugangsdaten bleiben auf dem Server, die Tabelle ist nicht öffentlich und Einsendungen werden durch Turnstile und eine Ratenbegrenzung geschützt. In der Tabelle wird keine IP-Adresse gespeichert.',
  },
  nl: {
    title: 'Privacy',
    description: 'Hoe Marxist Games omgaat met gegevens die via formulieren worden verzonden.',
    kicker: 'Persoonsgegevens',
    intro:
      'Informatie die via contactformulieren wordt verzonden, wordt uitsluitend gebruikt om je aanvraag te beantwoorden. Het adres uit het nieuwsbriefformulier wordt alleen gebruikt om je inschrijving te beheren en nieuws van Marxist Games te versturen. De rechtsgrond is toestemming en, wanneer een project wordt besproken, het nemen van precontractuele maatregelen.',
    collected: 'Verzamelde gegevens',
    collectedText:
      'Voor de nieuwsbrief: e-mailadres, taal, datum en versie van de toestemming, bron en inschrijvingsstatus. Voor contactaanvragen: naam, eventuele organisatie, e-mailadres en informatie die je zelf verstrekt. Het antispamveld, de starttijd en de Turnstile-controle worden alleen gebruikt om geautomatiseerde inzendingen te beperken.',
    retention: 'Bewaartermijn en ontvangers',
    retentionText:
      'Het nieuwsbriefadres wordt bewaard totdat je je toestemming intrekt. De gegevens zijn alleen toegankelijk voor bevoegde leden van Marxist Games, worden opgeslagen in een privé-Google-spreadsheet en voor verzending verwerkt door de toekomstige e-maildienst.',
    rights: 'Jouw rechten',
    rightsText:
      'Je kunt inzage, correctie of verwijdering van je gegevens vragen en je toestemming intrekken via marxismepourdebutant@gmail.com.',
    warning: 'Beveiliging van inschrijvingen',
    warningText:
      'Google-inloggegevens blijven op de server, de spreadsheet is niet openbaar en inzendingen worden beschermd door Turnstile en snelheidsbeperking. Er wordt geen IP-adres in de spreadsheet opgeslagen.',
  },
  it: {
    title: 'Privacy',
    description: 'Come Marxist Games tratta i dati inviati tramite i suoi moduli.',
    kicker: 'Dati personali',
    intro:
      'Le informazioni inviate tramite i moduli di contatto vengono utilizzate esclusivamente per rispondere alla richiesta. L’indirizzo inserito nel modulo newsletter viene usato solo per gestire l’iscrizione e inviare notizie di Marxist Games. La base giuridica è il consenso e, quando si discute un progetto, l’esecuzione di misure precontrattuali.',
    collected: 'Dati raccolti',
    collectedText:
      'Per la newsletter: indirizzo e-mail, lingua, data e versione del consenso, fonte e stato dell’iscrizione. Per le richieste di contatto: nome, eventuale organizzazione, indirizzo e-mail e informazioni che scegli di fornire. Il campo antispam, l’ora di inizio e il controllo Turnstile servono solo a limitare gli invii automatizzati.',
    retention: 'Conservazione e destinatari',
    retentionText:
      'L’indirizzo newsletter viene conservato fino alla revoca del consenso. I dati sono accessibili solo ai membri autorizzati di Marxist Games, archiviati in un foglio Google privato e, per l’invio, trattati dal futuro fornitore e-mail.',
    rights: 'I tuoi diritti',
    rightsText:
      'Puoi chiedere l’accesso, la rettifica o la cancellazione dei dati e revocare il consenso scrivendo a marxismepourdebutant@gmail.com.',
    warning: 'Protezione delle iscrizioni',
    warningText:
      'Le credenziali Google restano sul server, il foglio non è pubblico e gli invii sono protetti da Turnstile e da una limitazione di frequenza. Nel foglio non viene memorizzato alcun indirizzo IP.',
  },
};
const copy = pageTranslations[locale] ?? pageTranslations.en!;
const { title, description } = copy;
---

<BaseLayout {title} {description} {locale} translationLinks={translations}>
  <header class="page-hero">
    <div class="container page-hero__inner">
      <p class="section-kicker">{copy.kicker}</p><h1>{title}</h1><p>{description}</p>
    </div>
  </header>
  <section class="section">
    <div class="prose legal">
      <p>{copy.intro}</p><h2>{copy.collected}</h2><p>
        {copy.collectedText}
      </p><h2>{copy.retention}</h2><p>
        {copy.retentionText}
      </p><h2>{copy.rights}</h2><p>
        {copy.rightsText}
      </p><div class="notice">
        <strong>{copy.warning}</strong><p>{copy.warningText}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-inline: 1rem;
    overflow-wrap: anywhere;
  }
  .legal .notice {
    font-family: var(--font-sans);
  }
</style>
