---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../lib/i18n';
export const prerender = true;
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const translations: Partial<
  Record<Locale, { title: string; kicker: string; heading: string; text: string; home: string }>
> = {
  fr: {
    title: 'Page introuvable',
    kicker: 'Le chemin s’arrête ici',
    heading: 'Page introuvable.',
    text: 'Cette page a été déplacée, traduite ailleurs ou n’existe pas encore.',
    home: 'Retour à l’accueil',
  },
  en: {
    title: 'Page not found',
    kicker: 'The path ends here',
    heading: 'Page not found.',
    text: 'This page has moved, exists in another language or is not published yet.',
    home: 'Back home',
  },
  nl: {
    title: 'Pagina niet gevonden',
    kicker: 'Het pad eindigt hier',
    heading: 'Pagina niet gevonden.',
    text: 'Deze pagina is verplaatst, bestaat in een andere taal of is nog niet gepubliceerd.',
    home: 'Terug naar home',
  },
  it: {
    title: 'Pagina non trovata',
    kicker: 'Il percorso finisce qui',
    heading: 'Pagina non trovata.',
    text: 'Questa pagina è stata spostata, esiste in un’altra lingua o non è ancora pubblicata.',
    home: 'Torna alla home',
  },
};
const copy = translations[locale] ?? translations.en!;
---

<BaseLayout title={copy.title} description="Erreur 404" {locale}>
  <section class="not-found">
    <div class="container">
      <span>404</span><p class="section-kicker">{copy.kicker}</p><h1>{copy.heading}</h1><p>
        {copy.text}
      </p><div class="button-row">
        <a class="button" href={`/${locale}/`}>{copy.home}</a><a
          class="button button--ghost"
          href={`/${locale}/articles/`}>Articles</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    position: relative;
    min-height: 70vh;
    padding-block: var(--space-7);
    overflow: hidden;
  }
  .not-found .container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
  }
  .not-found .container > span {
    position: absolute;
    z-index: -1;
    top: -6rem;
    right: -2rem;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(12rem, 40vw, 30rem);
    line-height: 1;
  }
  .not-found .container > p:not(.section-kicker) {
    max-width: 35rem;
    color: var(--color-gray);
    font-size: var(--step-1);
  }
</style>
