const copy = copies[locale] as (typeof copies)[Locale];
---

<SupportPage
  {locale}
  title={copy.title}
  description={copy.description}
  kicker={copy.kicker}
  heading={copy.heading}
  primaryLabel={copy.primaryLabel}
  primaryHref={`/${locale}/contact/`}
  secondaryLabel={copy.secondaryLabel}
  secondaryHref={`/${locale}/jeux/`}
  pointsKicker={copy.pointsKicker}
  pointsTitle={copy.pointsTitle}
  points={copy.points}
  detailsKicker={copy.detailsKicker}
  detailsTitle={copy.detailsTitle}
  details={copy.details}
  notice={copy.notice}
  {translationLinks}
/>
