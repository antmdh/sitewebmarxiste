const { titles: serviceTitles, descriptions: serviceDescriptions } = services[locale];
const homeLabels: Record<
  Locale,
  {
    imageAlt: string;
    caption: string;
    primary: string;
    secondary: string;
    noGames: string;
    noArticles: string;
    languages: string;
  }
> = {
  fr: {
    imageAlt: 'Personnage pixel art inspiré de Marx sautant au-dessus de livres et de plateformes',
    caption: 'Marxists Games · Jeux, théorie et création',
    primary: 'Découvrir nos jeux',
    secondary: 'Commander un jeu',
    noGames: 'Les traductions des autres jeux sont en préparation.',
    noArticles: 'Les articles dans cette langue arrivent bientôt.',
    languages: 'Langues disponibles',
  },
  en: {
    imageAlt: 'Pixel-art character inspired by Marx jumping over books and platforms',
    caption: 'Marxists Games · Games, theory and creation',
    primary: 'Discover our games',
    secondary: 'Commission a game',
    noGames: 'Translations of the other games are in progress.',
    noArticles: 'Articles in this language are coming soon.',
    languages: 'Available languages',
  },
  es: {
    imageAlt: 'Personaje pixel art inspirado en Marx que salta sobre libros y plataformas',
    caption: 'Marxists Games · Juegos, teoría y creación',
    primary: 'Descubrir nuestros juegos',
    secondary: 'Encargar un juego',
    noGames: 'Las traducciones de los demás juegos están en preparación.',
    noArticles: 'Los artículos en este idioma llegarán pronto.',
    languages: 'Idiomas disponibles',
  },
  de: {
    imageAlt: 'Von Marx inspirierte Pixel-Art-Figur springt über Bücher und Plattformen',
    caption: 'Marxists Games · Spiele, Theorie und Gestaltung',
    primary: 'Unsere Spiele entdecken',
    secondary: 'Spiel beauftragen',
    noGames: 'Die Übersetzungen der anderen Spiele sind in Arbeit.',
    noArticles: 'Artikel in dieser Sprache folgen bald.',
    languages: 'Verfügbare Sprachen',
  },
  nl: {
    imageAlt: 'Door Marx geïnspireerd pixelpersonage springt over boeken en platformen',
    caption: 'Marxists Games · Spellen, theorie en creatie',
    primary: 'Ontdek onze spellen',
    secondary: 'Laat een spel maken',
    noGames: 'De vertalingen van de andere spellen zijn in voorbereiding.',
    noArticles: 'Artikelen in deze taal verschijnen binnenkort.',
    languages: 'Beschikbare talen',
  },
  it: {
    imageAlt: 'Personaggio in pixel art ispirato a Marx che salta sopra libri e piattaforme',
    caption: 'Marxists Games · Giochi, teoria e creazione',
    primary: 'Scopri i nostri giochi',
    secondary: 'Commissiona un gioco',
    noGames: 'Le traduzioni degli altri giochi sono in preparazione.',
    noArticles: 'Gli articoli in questa lingua arriveranno presto.',
    languages: 'Lingue disponibili',
  },
};
const labels = homeLabels[locale];
const heroTicker: Record<Locale, string[]> = {
  fr: ['JEUX', 'HISTOIRE', 'MARXISME', 'CRÉATION'],
  en: ['GAMES', 'HISTORY', 'MARXISM', 'CREATION'],
  es: ['JUEGOS', 'HISTORIA', 'MARXISMO', 'CREACIÓN'],
  de: ['SPIELE', 'GESCHICHTE', 'MARXISMUS', 'GESTALTUNG'],
  nl: ['SPELLEN', 'GESCHIEDENIS', 'MARXISME', 'CREATIE'],
  it: ['GIOCHI', 'STORIA', 'MARXISMO', 'CREAZIONE'],
};

const serviceIcons = [
  gameDesignIcon,
  scenarioIcon,
  prototypeIcon,
  pedagogicalIcon,
  militantIcon,
  technicalIcon,
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Marxists Games',
  url: 'https://www.marxistsgames.org',
  description: copy.intro.replaceAll('\n', ' '),
};
---

<BaseLayout
  title="Marxists Games"
  description={copy.intro.replaceAll('\n', ' ')}
  {locale}
  image={brandBackground}
  translationLinks={staticTranslations}
  {structuredData}
>
  <Hero
    eyebrow={copy.eyebrow}
    title={copy.title}
    intro={copy.intro}
    image={brandBackground}
    imageAlt={labels.imageAlt}
    caption={labels.caption}
    primaryHref={`/${locale}/jeux/`}
    primaryLabel={labels.primary}
    secondaryHref={`/${locale}/commander-un-jeu/`}
    secondaryLabel={labels.secondary}
    ticker={heroTicker[locale]}
  />

  <section class="section">
    <div class="container">
      <header class="section-heading">
        <p class="section-kicker">{copy.gamesKicker}</p><h2>{copy.gamesTitle}</h2><p>
          {copy.gamesText}
        </p>
      </header>
      {
        games.length > 0 ? (
          <div class="grid-3">
            {games.map((game) => (
              <GameCard {game} {locale} />
            ))}
          </div>
        ) : (
          <p class="notice">{labels.noGames}</p>
        )
      }
      <div class="section-cta">
        <a class="button button--ghost" href={`/${locale}/jeux/`}>
          {copy.allGames}
          <PixelIcon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark commission">
    <div class="container">
      <header class="section-heading">
        <p class="section-kicker">{copy.commissionKicker}</p><h2>{copy.commissionTitle}</h2><p>
          {copy.commissionText}
        </p>
      </header>
      <div class="grid-3">
        {
          serviceTitles.map((title, index) => (
            <ServiceCard
              number={`0${index + 1}`}
              icon={serviceIcons[index]}
              {title}
              description={serviceDescriptions[index]}
            />
          ))
        }
      </div>
      <a class="button button--cream commission__button" href={`/${locale}/commander-un-jeu/`}
        >{copy.commissionButton}<PixelIcon name="arrow" size={17} /></a
      >
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-heading">
        <p class="section-kicker">{copy.articleKicker}</p><h2>{copy.articleTitle}</h2><p>
          {copy.articleText}
        </p>
      </header>
      {
        articles.length > 0 ? (
          <div class="grid-3">
            {articles.map((article) => (
              <ArticleCard {article} {locale} />
            ))}
          </div>
        ) : (
          <p class="notice">{labels.noArticles}</p>
        )
      }
      <div class="section-cta">
        <a class="button button--ghost" href={`/${locale}/articles/`}>
          {copy.allArticles}
          <PixelIcon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>

  <CommunitySection {locale} />

  <section class="section language-band">
    <div class="container language-band__grid">
      <div>
        <p class="section-kicker">{copy.langKicker}</p><h2>{copy.langTitle}</h2><p>
          {copy.langText}
        </p>
      </div>
      <nav aria-label={labels.languages}>
        <ul class="no-list">
          {
            locales.map((item, index) => (
              <li>
                <a href={`/${item}/`} hreflang={item}>
                  <PixelIcon name="globe" size={24} />
                  <span>0{index + 1}</span>
                  {localeNames[item]} <PixelIcon name="arrow" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <section class="section newsletter-band">
    <div class="container newsletter-band__grid">
      <div>
        <p class="section-kicker">Newsletter</p><h2>{copy.newsletterTitle}</h2><p>
          {copy.newsletterText}
        </p>
      </div><NewsletterForm {locale} compact />
    </div>
  </section>
</BaseLayout>

<style>
  .section-cta {
    margin-top: var(--space-6);
  }
  .commission {
    position: relative;
    overflow: hidden;
    color: var(--color-black);
    background-color: var(--color-paper);
    background-image: var(--texture-staggered-mosaic);
    background-size: var(--texture-mosaic-size);
    background-position: 0 0;
    box-shadow: inset 0 0.35rem 0 var(--color-red);
  }
  .commission::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(7rem, 18vw, 15rem);
    height: clamp(3rem, 9vw, 7rem);
    background: var(--color-red);
    content: '';
    clip-path: polygon(35% 0, 100% 0, 100% 100%, 0 100%, 0 70%, 15% 70%, 15% 40%, 35% 40%);
    opacity: 0.3;
  }
  .commission :global(.section-kicker),
  .commission :global(.section-heading p),
  .commission :global(.service-card p) {
    color: var(--color-gray);
  }
  .commission :global(.service-card) {
    border-color: var(--color-black);
    color: var(--color-black);
    background: var(--color-paper);
    box-shadow: 0.28rem 0.28rem 0 var(--color-red);
  }
  .commission :global(.service-card > span) {
    color: var(--color-white);
  }
  .commission__button {
    position: relative;
    z-index: 1;
    margin-top: var(--space-6);
  }
  .language-band {
    background-color: var(--color-cream);
    background-image: var(--texture-staggered-mosaic);
    background-size: var(--texture-mosaic-size);
    background-position: 0 0;
  }
  .language-band__grid {
    display: grid;
