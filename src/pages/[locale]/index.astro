---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import CommunitySection from '../../components/CommunitySection.astro';
import GameCard from '../../components/GameCard.astro';
import Hero from '../../components/Hero.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, localeNames, type Locale } from '../../lib/i18n';
import brandBackground from '../../assets/images/marxists-games-background.webp';
import gameDesignIcon from '../../assets/images/services/icone_gamedesign_blanc.png';
import militantIcon from '../../assets/images/services/icone_militant_blanc.png';
import pedagogicalIcon from '../../assets/images/services/icone_pedagogique_blanc.png';
import prototypeIcon from '../../assets/images/services/icone_prototype_blanc.png';
import scenarioIcon from '../../assets/images/services/icone_scenario_blanc.png';
import technicalIcon from '../../assets/images/services/icone_technique_blanc.png';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const games = (await getCollection('games', ({ data }) => data.locale === locale && !data.draft))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const articles = (
  await getCollection('articles', ({ data }) => data.locale === locale && !data.draft)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const staticTranslations = locales.map((item) => ({ locale: item, href: `/${item}/` }));

const copy = {
