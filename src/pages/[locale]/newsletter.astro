---
import NewsletterForm from '../../components/NewsletterForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../lib/i18n';

export const prerender = true;
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const title = 'Newsletter';
const translations = locales.map((item) => ({ locale: item, href: `/${item}/newsletter/` }));
const pageTranslations: Partial<
  Record<
    Locale,
    {
      description: string;
      kicker: string;
      heading: string;
      items: string[];
      subscribe: string;
      notice: string;
    }
  >
> = {
  fr: {
    description:
      'Recevoir les nouvelles des jeux, des articles et des appels à test de Marxists Games.',
    kicker: 'La voie calme',
    heading: 'Des nouvelles, pas du bruit.',
    items: [
      'Avancement des jeux',
      'Nouveaux articles',
      'Appels à test',
      'Événements de la communauté',
    ],
    subscribe: 'S’inscrire',
    notice:
      'Le prestataire d’envoi et la fréquence définitive restent à valider. Aucune adresse ne sera transmise à un tiers à des fins commerciales.',
  },
  en: {
    description: 'Receive news about Marxists Games projects, articles and playtests.',
    kicker: 'The quieter route',
    heading: 'News, not noise.',
    items: ['Game development', 'New articles', 'Playtest calls', 'Community events'],
    subscribe: 'Subscribe',
    notice:
      'The sending provider and final frequency still need approval. Addresses will never be sold for commercial use.',
  },
  nl: {
    description: 'Ontvang nieuws over de spellen, artikelen en speeltests van Marxists Games.',
    kicker: 'De rustige route',
    heading: 'Nieuws, geen ruis.',
    items: [
      'Ontwikkeling van spellen',
      'Nieuwe artikelen',
      'Oproepen voor speeltests',
      'Gemeenschapsevenementen',
    ],
    subscribe: 'Inschrijven',
    notice:
      'De verzenddienst en de definitieve frequentie moeten nog worden bevestigd. Adressen worden nooit voor commerciële doeleinden doorgegeven.',
  },
  it: {
    description: 'Ricevi notizie sui giochi, gli articoli e i playtest di Marxists Games.',
    kicker: 'La via più tranquilla',
    heading: 'Notizie, non rumore.',
    items: ['Sviluppo dei giochi', 'Nuovi articoli', 'Inviti ai playtest', 'Eventi della comunità'],
    subscribe: 'Iscriviti',
    notice:
      'Il servizio di invio e la frequenza definitiva devono ancora essere confermati. Gli indirizzi non saranno mai ceduti per fini commerciali.',
  },
};
const copy = pageTranslations[locale] ?? pageTranslations.en!;
const { description } = copy;
---

<BaseLayout {title} {description} {locale} translationLinks={translations}>
  <section class="newsletter-page">
    <div class="container newsletter-page__grid">
      <div>
        <p class="section-kicker">{copy.kicker}</p><h1>{copy.heading}</h1><p>
          {description}
        </p><ul>
          {copy.items.map((item) => <li>{item}</li>)}
        </ul>
      </div><div class="newsletter-page__form">
        <h2>{copy.subscribe}</h2><NewsletterForm {locale} /><p class="notice">{copy.notice}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .newsletter-page {
    padding-block: var(--space-7);
    min-height: 70vh;
    background: var(--color-cream);
  }
  .newsletter-page__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .newsletter-page__grid > div:first-child {
    display: grid;
    gap: var(--space-4);
  }
  .newsletter-page__grid > div:first-child > p:not(.section-kicker) {
    color: var(--color-gray);
    font-size: var(--step-1);
  }
  .newsletter-page ul {
    padding-left: 1.3rem;
    font-weight: 800;
  }
  .newsletter-page__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 0.12rem solid var(--color-black);
    background: var(--color-paper);
    box-shadow: var(--shadow-hard);
  }
  .newsletter-page__form h2 {
    font-size: var(--step-2);
  }
  .newsletter-page__form .notice {
    font-size: var(--step--1);
  }
  @media (min-width: 58rem) {
    .newsletter-page__grid {
      grid-template-columns: 1fr 0.9fr;
    }
  }
</style>
