---
import PixelIcon from './PixelIcon.astro';

interface Props {
  number: string;
  title: string;
  description: string;
  icon: 'gamepad' | 'quill' | 'tools' | 'book' | 'community' | 'gear' | 'globe';
}

const { number, title, description, icon } = Astro.props;
---

<article class="service-card">
  <span class="service-card__number" aria-hidden="true">{number}</span>
  <span class="service-card__icon" aria-hidden="true">
    <PixelIcon name={icon} size={44} />
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .service-card {
    position: relative;
    display: grid;
    min-height: 11.5rem;
    gap: var(--space-2);
    align-content: start;
    padding: 5rem var(--space-3) var(--space-3);
    overflow: hidden;
    border: 0.19rem solid currentColor;
    background-color: rgb(255 240 189 / 0.06);
    box-shadow: 0.28rem 0.28rem 0 var(--color-red);
  }

  .service-card__number {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    padding: 0.2rem 0.38rem;
    border: 0.12rem solid currentColor;
    color: var(--color-red-bright);
    background: var(--color-black);
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1;
  }

  .service-card__icon {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 0.16rem solid var(--color-black);
    color: var(--color-cream);
    background: var(--color-red);
    box-shadow:
      0.18rem 0 0 var(--color-black),
      0 0.18rem 0 var(--color-black);
  }

  .service-card h3 {
    position: relative;
    font-size: var(--step-2);
  }

  .service-card p {
    position: relative;
    color: var(--color-paper-deep);
    font-size: var(--step--1);
  }
</style>
