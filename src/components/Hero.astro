---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gameDesignIcon from '../assets/images/services/icone_gamedesign_blanc.png';
import prototypeIcon from '../assets/images/services/icone_prototype_blanc.png';
import ButtonImageIcon from './ButtonImageIcon.astro';

interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  eyebrow?: string;
  caption?: string;
  ticker?: string[];
}

const {
  title,
  intro,
  image,
  imageAlt,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  eyebrow = 'Marxists Games · Association · Studio Indépendant',
  caption = 'Marxists Games · Illustration d’accueil',
  ticker = ['JEUX', 'HISTOIRE', 'MARXISME', 'CRÉATION'],
} = Astro.props;
---

<section class="hero">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="section-kicker">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero__intro">{intro}</p>
      <div class="button-row">
        <a class="button" href={primaryHref}>
          <ButtonImageIcon src={gameDesignIcon} />
          {primaryLabel}
        </a>
        <a class="button button--ghost" href={secondaryHref}>
          <ButtonImageIcon src={prototypeIcon} />
          {secondaryLabel}
        </a>
      </div>
    </div>
    <figure class="hero__visual pixel-image">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 640, 800]}
        sizes="(min-width: 64rem) 48vw, 100vw"
        format="webp"
        loading="eager"
      />
      <figcaption>{caption}</figcaption>
    </figure>
  </div>
  <div class="hero__ticker" aria-hidden="true">
    {
      ticker.map((item, index) => (
        <>
          <span>{item}</span>
          {index < ticker.length - 1 && <i />}
        </>
      ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(1.7rem, 4vw, 3.5rem);
    border-bottom: 0.35rem solid var(--color-black);
    color: var(--color-black);
    background-color: var(--color-paper);
    background-image: var(--texture-staggered-mosaic);
    background-size: var(--texture-mosaic-size);
    background-position: 0 0;
  }

  .hero::before {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(8rem, 22vw, 20rem);
    height: clamp(3rem, 8vw, 7rem);
    background: var(--color-red);
    content: '';
    clip-path: polygon(
      20% 0,
      100% 0,
      100% 65%,
      82% 65%,
      82% 82%,
      55% 82%,
      55% 100%,
      0 100%,
      0 35%,
      20% 35%
    );
    opacity: 0.9;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }

  .hero h1 {
    max-width: 15ch;
    text-shadow: 0.08em 0.08em 0 rgb(184 52 30 / 0.2);
  }

  .hero .section-kicker {
    width: fit-content;
    -webkit-text-stroke: 0.1em var(--color-cream);
    paint-order: stroke fill;
    text-shadow:
      -0.08em -0.08em 0 var(--color-cream),
      0 -0.08em 0 var(--color-cream),
      0.08em -0.08em 0 var(--color-cream),
      -0.08em 0 0 var(--color-cream),
      0.08em 0 0 var(--color-cream),
      -0.08em 0.08em 0 var(--color-cream),
      0 0.08em 0 var(--color-cream),
      0.08em 0.08em 0 var(--color-cream);
  }

  .hero__intro {
    max-width: 38rem;
    color: var(--color-ink-light);
    font-size: var(--step-0);
    font-weight: 650;
    line-height: 1.4;
    white-space: pre-line;
  }

  .hero .button--ghost {
    border-color: var(--color-dark-red);
    color: var(--color-dark-red);
    background: var(--color-cream);
  }

  .hero__visual {
    position: relative;
    align-self: end;
    margin: 0.4rem 0 var(--space-5);
    border: 0.28rem solid var(--color-black);
    background: var(--color-red);
    box-shadow:
      0.5rem 0.5rem 0 var(--color-black),
      inset 0 0 0 0.18rem var(--color-paper-highlight);
  }

  .hero__visual::before {
    position: absolute;
    z-index: 3;
    top: -0.7rem;
    left: -0.7rem;
    width: 3.4rem;
    height: 3.4rem;
    border-top: 0.6rem solid var(--color-red-bright);
    border-left: 0.6rem solid var(--color-red-bright);
    content: '';
  }

  .hero__visual :global(img) {
    width: 100%;
    height: clamp(17rem, 58vw, 23rem);
    object-fit: cover;
    object-position: center;
    filter: contrast(1.16) saturate(0.8);
    image-rendering: pixelated;
  }

  .hero__visual figcaption {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    padding: 0.4rem 0.6rem;
    border-top: 0.12rem solid var(--color-paper);
    border-left: 0.12rem solid var(--color-paper);
    color: var(--color-paper);
    background: var(--color-black);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__ticker {
    position: relative;
    z-index: 2;
    display: flex;
    min-width: max-content;
    gap: 1.2rem;
    align-items: center;
    margin-top: 0;
    padding: 0.65rem 1rem;
    border-top: 0.2rem solid var(--color-black);
    color: var(--color-cream);
    background: var(--color-black);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .hero__ticker i {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--color-red-bright);
    rotate: 45deg;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 0.96fr 1.04fr;
    }

    .hero__copy {
      padding-block: var(--space-5) var(--space-6);
    }

    .hero__visual :global(img) {
      height: 29rem;
    }

    .hero__ticker {
      justify-content: space-around;
    }
  }
</style>
