---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  eyebrow?: string;
  caption?: string;
}

const {
  title,
  intro,
  image,
  imageAlt,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  eyebrow = 'Marxists Games · Association',
  caption = 'Marxists Games · Illustration d’accueil',
} = Astro.props;
---

<section class="hero">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="section-kicker">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero__intro">{intro}</p>
      <div class="button-row">
        <a class="button" href={primaryHref}>{primaryLabel}</a>
        <a class="button button--ghost" href={secondaryHref}>{secondaryLabel}</a>
      </div>
    </div>
    <figure class="hero__visual">
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 64rem) 48vw, 100vw"
        format="webp"
        loading="eager"
      />
      <figcaption>{caption}</figcaption>
    </figure>
  </div>
  <div class="hero__ticker" aria-hidden="true">
    <span>JEUX</span><i></i><span>HISTOIRE</span><i></i><span>MARXISME</span><i></i><span
      >CRÉATION</span
    >
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 6rem);
    color: var(--color-paper);
    background: var(--color-black);
  }

  .hero::before {
    position: absolute;
    top: -2rem;
    right: -8rem;
    width: 23rem;
    height: 8rem;
    background: var(--color-red);
    content: '';
    rotate: -20deg;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero__intro {
    max-width: 38rem;
    color: var(--color-cream);
    font-size: var(--step-1);
    line-height: 1.45;
    white-space: pre-line;
  }

  .hero .button--ghost {
    border-color: var(--color-cream);
    color: var(--color-cream);
  }

  .hero__visual {
    position: relative;
    align-self: end;
    margin-right: -1rem;
  }

  .hero__visual::before {
    position: absolute;
    z-index: 1;
    top: -0.85rem;
    left: -0.85rem;
    width: 4.5rem;
    height: 4.5rem;
    border-top: 0.7rem solid var(--color-red-bright);
    border-left: 0.7rem solid var(--color-red-bright);
    content: '';
  }

  .hero__visual :global(img) {
    width: 100%;
    min-height: 21rem;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.03) saturate(0.94);
  }

  .hero__visual figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.4rem 0.6rem;
    color: var(--color-paper);
    background: var(--color-black);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__ticker {
    position: relative;
    z-index: 2;
    display: flex;
    min-width: max-content;
    gap: 1.2rem;
    align-items: center;
    margin-top: -0.1rem;
    padding: 0.7rem 1rem;
    color: var(--color-black);
    background: var(--color-cream);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .hero__ticker i {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--color-red);
    rotate: 45deg;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.02fr 0.98fr;
    }

    .hero__copy {
      padding-block: var(--space-6) var(--space-7);
    }

    .hero__visual :global(img) {
      height: 39rem;
    }

    .hero__ticker {
      justify-content: space-around;
    }
  }
</style>
