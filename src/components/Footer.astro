const t = text[locale];
const columns = [
  {
    title: t.games,
    links: [
      ['Russia 1917', `/${locale}/jeux/russia-1917/`],
      [t.singSing, `/${locale}/jeux/`],
      [t.allGames, `/${locale}/jeux/`],
    ],
  },
  {
    title: t.studio,
    links: [
      [t.commissions, `/${locale}/commander-un-jeu/`],
      [t.method, `/${locale}/commander-un-jeu/#methode`],
      ['Contact', `/${locale}/contact/`],
    ],
  },
  {
    title: t.articles,
    links: [
      [t.devlogs, `/${locale}/articles/categories/devlog/`],
      [t.marxistGames, `/${locale}/articles/categories/marxist-games/`],
      [t.essays, `/${locale}/articles/categories/marxism-games/`],
    ],
  },
  {
    title: t.community,
    links: [
      ['Discord', 'https://discord.gg/placeholder'],
      ['Newsletter', `/${locale}/newsletter/`],
      [t.volunteerTester, `/${locale}/devenir-testeur-benevole/`],
      [t.donate, `/${locale}/faire-un-don/`],
      [t.resources, `/${locale}/communaute/`],
    ],
  },
  {
    title: t.about,
    links: [
      [t.who, `/${locale}/a-propos/`],
      [t.values, `/${locale}/a-propos/#valeurs`],
      [t.legal, `/${locale}/mentions-legales/`],
      [t.privacy, `/${locale}/confidentialite/`],
    ],
  },
  {
    title: t.languages,
    links: locales.map((item) => [localeNames[item], `/${item}/`]),
  },
];
const columnIcons = ['gamepad', 'tools', 'article', 'community', 'info', 'globe'] as const;
---

<footer class="site-footer">
  <div class="site-footer__top container">
    <div class="site-footer__manifesto">
      <Logo {locale} />
      <p>{t.manifesto}</p>
    </div>
    <div class="site-footer__columns">
      {
        columns.map((column, index) => (
          <section>
            <h2>
              <PixelIcon name={columnIcons[index]} size={16} />
              {column.title}
            </h2>
            <ul class="no-list">
              {column.links.map(([label, href]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
  <div class="site-footer__bottom container">
    <p>© {new Date().getFullYear()} Marxists Games · {t.association}</p>
    <a href="/fr/">{t.mainLanguage}</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-6);
    border-top: 0.35rem solid var(--color-red);
    color: var(--color-paper);
    background-color: var(--color-black);
    background-image:
      linear-gradient(90deg, rgb(255 240 189 / 0.025) 1px, transparent 1px),
      linear-gradient(rgb(255 240 189 / 0.025) 1px, transparent 1px);
    background-size: 5px 5px;
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__manifesto {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .site-footer__manifesto p {
    max-width: 18rem;
    color: var(--color-paper-deep);
    font-size: var(--step--1);
    font-weight: 750;
    text-transform: uppercase;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }

  .site-footer h2 {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin-bottom: var(--space-3);
    color: var(--color-red-bright);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.13em;
  }

  .site-footer li + li {
    margin-top: 0.55rem;
  }

  .site-footer a {
    color: inherit;
    font-family: var(--font-pixel);
    font-size: var(--step--1);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    margin-top: var(--space-6);
    padding-block: var(--space-4);
    border-top: 0.16rem solid var(--color-paper-deep);
    color: var(--color-paper-deep);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  @media (min-width: 50rem) {
    .site-footer__top {
      grid-template-columns: 0.8fr 2fr;
    }

    .site-footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .site-footer__columns {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
