---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  variant?: 'project' | 'contact';
}

const { locale, variant = 'project' } = Astro.props;
const translations: Partial<Record<Locale, Record<string, string>>> = {
  fr: {
    name: 'Nom',
    organization: 'Organisation',
    projectType: 'Type de projet',
    audience: 'Public visé',
    platform: 'Plateforme',
    undefined: 'À définir',
    budget: 'Budget indicatif',
    discuss: 'À discuter',
    timeline: 'Calendrier souhaité',
    timelineExample: 'Ex. septembre 2027',
    description: 'Description du projet',
    hint: 'Contexte, objectif, contenu envisagé et contraintes connues — 30 caractères minimum.',
    consent:
      'J’accepte que Marxist Games utilise ces informations pour me recontacter au sujet de ma demande.',
    send: 'Envoyer la demande',
    required: 'Les champs marqués d’un astérisque sont obligatoires.',
  },
  en: {
    name: 'Name',
    organization: 'Organisation',
    projectType: 'Project type',
    audience: 'Target audience',
    platform: 'Platform',
    undefined: 'To be defined',
    budget: 'Indicative budget',
    discuss: 'To discuss',
    timeline: 'Desired timeline',
    timelineExample: 'E.g. September 2027',
    description: 'Project description',
    hint: 'Context, objective, expected content and known constraints — 30 characters minimum.',
    consent: 'I agree that Marxist Games may use this information to contact me about my request.',
    send: 'Send request',
    required: 'Fields marked with an asterisk are required.',
  },
  nl: {
    name: 'Naam',
    organization: 'Organisatie',
    projectType: 'Projecttype',
    audience: 'Doelgroep',
    platform: 'Platform',
    undefined: 'Nog te bepalen',
    budget: 'Indicatief budget',
    discuss: 'Te bespreken',
    timeline: 'Gewenste planning',
    timelineExample: 'Bijv. september 2027',
    description: 'Projectbeschrijving',
    hint: 'Context, doel, verwachte inhoud en bekende beperkingen — minimaal 30 tekens.',
    consent:
      'Ik ga ermee akkoord dat Marxist Games deze gegevens gebruikt om contact met mij op te nemen over mijn aanvraag.',
    send: 'Aanvraag versturen',
    required: 'Velden met een sterretje zijn verplicht.',
  },
  it: {
    name: 'Nome',
    organization: 'Organizzazione',
    projectType: 'Tipo di progetto',
    audience: 'Pubblico di riferimento',
    platform: 'Piattaforma',
    undefined: 'Da definire',
    budget: 'Budget indicativo',
    discuss: 'Da discutere',
    timeline: 'Tempistica desiderata',
    timelineExample: 'Es. settembre 2027',
    description: 'Descrizione del progetto',
    hint: 'Contesto, obiettivo, contenuto previsto e vincoli noti — minimo 30 caratteri.',
    consent:
      'Accetto che Marxist Games utilizzi queste informazioni per ricontattarmi in merito alla mia richiesta.',
    send: 'Invia la richiesta',
    required: 'I campi contrassegnati da un asterisco sono obbligatori.',
  },
};
const labels = translations[locale] ?? translations.en!;
---

<form class="contact-form" action="/api/contact" method="post" data-contact-form>
  <div class="form-grid">
    <div class="field">
      <label for="name">{labels.name} <span aria-hidden="true">*</span></label>
      <input id="name" name="name" type="text" autocomplete="name" required minlength="2" />
    </div>
    <div class="field">
      <label for="organization">{labels.organization}</label>
      <input id="organization" name="organization" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="email">E-mail <span aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    {
      variant === 'project' && (
        <div class="field">
          <label for="projectType">
            {labels.projectType} <span aria-hidden="true">*</span>
          </label>
          <input id="projectType" name="projectType" type="text" required maxlength="80" />
        </div>
      )
    }
    {
      variant === 'project' && (
        <>
          <div class="field">
            <label for="audience">{labels.audience}</label>
            <input id="audience" name="audience" type="text" />
          </div>
          <div class="field">
            <label for="platform">{labels.platform}</label>
            <select id="platform" name="platform">
              <option value="">{labels.undefined}</option>
              <option>Web</option>
              <option>PC</option>
              <option>Android / iOS</option>
              <option>Installation</option>
            </select>
          </div>
          <div class="field">
            <label for="budget">{labels.budget}</label>
            <select id="budget" name="budget">
              <option value="">{labels.discuss}</option>
              <option value="under-5k">&lt; 5 000 €</option>
              <option value="5-15k">5 000–15 000 €</option>
              <option value="15-40k">15 000–40 000 €</option>
              <option value="over-40k">40 000 € +</option>
            </select>
          </div>
          <div class="field">
            <label for="timeline">{labels.timeline}</label>
            <input id="timeline" name="timeline" type="text" placeholder={labels.timelineExample} />
          </div>
        </>
      )
    }
    <div class="field field--wide">
      <label for="description"
        >{labels.description}
        <span aria-hidden="true">*</span></label
      >
      <textarea
        id="description"
        name="description"
        rows="8"
        required
        minlength="30"
        aria-describedby="description-hint"></textarea>
      <small id="description-hint">{labels.hint}</small>
    </div>
  </div>
  <div class="field honeypot" aria-hidden="true">
    <label for="website">Website</label><input
      id="website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <label class="consent">
    <input type="checkbox" name="consent" value="yes" required />
    <span
      >{labels.consent}
      <span aria-hidden="true">*</span></span
    >
  </label>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="formStartedAt" value={Date.now()} />
  <div class="form-actions">
    <button class="button" type="submit">{labels.send}</button>
    <p class="form-status" data-form-status aria-live="polite">
      {labels.required}
    </p>
  </div>
</form>

<script is:inline src="/scripts/contact-form.js" defer></script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .form-grid {
    display: grid;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label,
  .consent {
    font-size: var(--step--1);
    font-weight: 800;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem;
    border: 0.19rem solid var(--color-black);
    border-radius: 0;
    color: var(--color-black);
    background: var(--color-paper-highlight);
    box-shadow: inset 0.2rem 0.2rem 0 var(--color-paper-deep);
  }

  .field textarea {
    min-height: 11rem;
    resize: vertical;
  }

  .field small {
    color: var(--color-gray);
  }

  .consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .consent input {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    margin-top: 0.15rem;
    accent-color: var(--color-red);
  }

  .honeypot {
    position: absolute;
    left: -10000px;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .form-status {
    max-width: 34rem;
    color: var(--color-gray);
    font-size: var(--step--1);
  }

  .button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  @media (min-width: 44rem) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }
</style>
