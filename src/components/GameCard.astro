---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import gameDesignIcon from '../assets/images/services/icone_gamedesign_blanc.png';
import type { Locale } from '../lib/i18n';
import { ui } from '../lib/i18n';
import ButtonImageIcon from './ButtonImageIcon.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
  game: CollectionEntry<'games'>;
  locale: Locale;
}

const { game, locale } = Astro.props;
const t = ui[locale];
---

<article class="game-card card">
  <div class="game-card__image pixel-image">
    <Image
      src={game.data.heroImage}
      alt={game.data.heroAlt}
      widths={[320, 480]}
      sizes="(min-width: 70rem) 32vw, (min-width: 44rem) 50vw, 100vw"
      format="webp"
      loading="lazy"
    />
    <span class="tag">{game.data.developmentStatus}</span>
  </div>
  <div class="game-card__body">
    <p class="eyebrow">{game.data.genre}</p>
    <h3>{game.data.title}</h3>
    <p>{game.data.cardDescription ?? game.data.description}</p>
    <div class="game-card__meta">
      <span>{game.data.platforms.join(' · ')}</span>
      <span>{game.data.historicalPeriod}</span>
    </div>
    <div class="button-row">
      <a class="button" href={`/${locale}/jeux/${game.data.slug}/`}>
        <ButtonImageIcon src={gameDesignIcon} />
        {t.viewGame}
      </a>
      {
        game.data.devlogUrl && (
          <a class="button button--ghost" href={game.data.devlogUrl}>
            <PixelIcon name="book" size={18} />
            {t.devlog}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .game-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .game-card__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    border-bottom: 0.19rem solid var(--color-black);
    background: var(--color-charcoal);
  }

  .game-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.2) saturate(0.72) sepia(0.08);
    image-rendering: pixelated;
    transition: scale 140ms steps(2, end);
  }

  .game-card:hover .game-card__image :global(img) {
    scale: 1.025;
  }

  .game-card__image .tag {
    position: absolute;
    z-index: 3;
    right: 0.65rem;
    bottom: 0.65rem;
    max-width: calc(100% - 1.3rem);
  }

  .game-card__body {
    display: grid;
    flex: 1;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .game-card__body > p:not(.eyebrow) {
    color: var(--color-gray);
    font-size: var(--step--1);
  }

  .game-card__meta {
    display: grid;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 0.12rem dashed var(--color-gray);
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .game-card .button {
    flex: 1 1 9rem;
    min-height: 2.65rem;
  }
</style>
