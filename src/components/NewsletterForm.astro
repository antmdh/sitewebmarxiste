---
import type { Locale } from '../lib/i18n';
import PixelIcon from './PixelIcon.astro';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const configuredTurnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const turnstileSiteKey =
  configuredTurnstileSiteKey || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
const labels = {
  fr: {
    email: 'Votre adresse e-mail',
    button: 'S’inscrire',
    consent: 'J’accepte de recevoir les nouvelles de Marxist Games.',
    privacy: 'Lire la politique de confidentialité.',
    status: 'Votre adresse ne sera pas vendue ni utilisée à des fins commerciales.',
    unavailable: 'Les inscriptions sont temporairement indisponibles.',
  },
  en: {
    email: 'Your email address',
    button: 'Subscribe',
    consent: 'I agree to receive news from Marxist Games.',
    privacy: 'Read the privacy policy.',
    status: 'Your address will not be sold or used for commercial purposes.',
    unavailable: 'Subscriptions are temporarily unavailable.',
  },
  es: {
    email: 'Tu correo electrónico',
    button: 'Suscribirse',
    consent: 'Acepto recibir noticias de Marxist Games.',
    privacy: 'Leer la política de privacidad.',
    status: 'Tu dirección no se venderá ni se utilizará con fines comerciales.',
    unavailable: 'Las suscripciones no están disponibles temporalmente.',
  },
  de: {
    email: 'Deine E-Mail-Adresse',
    button: 'Anmelden',
    consent: 'Ich möchte Neuigkeiten von Marxist Games erhalten.',
    privacy: 'Datenschutzerklärung lesen.',
    status: 'Deine Adresse wird weder verkauft noch für kommerzielle Zwecke verwendet.',
    unavailable: 'Anmeldungen sind vorübergehend nicht verfügbar.',
  },
  nl: {
    email: 'Je e-mailadres',
    button: 'Inschrijven',
    consent: 'Ik ga ermee akkoord nieuws van Marxist Games te ontvangen.',
    privacy: 'Lees het privacybeleid.',
    status: 'Je adres wordt niet verkocht of voor commerciële doeleinden gebruikt.',
    unavailable: 'Inschrijvingen zijn tijdelijk niet beschikbaar.',
  },
  it: {
    email: 'Il tuo indirizzo e-mail',
    button: 'Iscriviti',
    consent: 'Accetto di ricevere notizie da Marxist Games.',
    privacy: 'Leggi l’informativa sulla privacy.',
    status: 'Il tuo indirizzo non sarà venduto né utilizzato per fini commerciali.',
    unavailable: 'Le iscrizioni sono temporaneamente non disponibili.',
  },
}[locale];
---

<form
  class:list={['newsletter-form', { 'newsletter-form--compact': compact }]}
  action="/api/newsletter"
  method="post"
  data-newsletter-form
>
  <div class="newsletter-form__field">
    <label for={`newsletter-email-${compact ? 'compact' : 'full'}`}>{labels.email}</label>
    <input
      id={`newsletter-email-${compact ? 'compact' : 'full'}`}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder="email@example.org"
    />
  </div>
  <label class="newsletter-form__consent">
    <input type="checkbox" name="consent" value="yes" required />
    <span>
      {labels.consent}
      <a href={`/${locale}/confidentialite/`}>{labels.privacy}</a>
    </span>
  </label>
  <input
    class="honeypot"
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="formStartedAt" value={Date.now()} />
  {
    turnstileSiteKey ? (
      <div
        class="cf-turnstile newsletter-form__turnstile"
        data-sitekey={turnstileSiteKey}
        data-action="newsletter"
        data-language={locale}
        data-size="flexible"
      />
    ) : (
      <p class="newsletter-form__configuration">{labels.unavailable}</p>
    )
  }
  <button class="button" type="submit" disabled={!turnstileSiteKey}>
    <PixelIcon name="mail" size={18} />
    {labels.button}
  </button>
  <p class="newsletter-form__status" data-newsletter-status aria-live="polite">
    {labels.status}
  </p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline src="/scripts/newsletter-form.js" defer></script>

<style>
  .newsletter-form {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .newsletter-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .newsletter-form label {
    font-family: var(--font-pixel);
    font-size: var(--step--1);
    font-weight: 800;
  }

  .newsletter-form input[type='email'] {
    min-height: 3.3rem;
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 0.19rem solid var(--color-black);
    border-radius: 0;
    color: var(--color-black);
    background: var(--color-paper-highlight);
    box-shadow: inset 0.2rem 0.2rem 0 var(--color-paper-deep);
  }

  .newsletter-form__consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .newsletter-form__consent input {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    accent-color: var(--color-red);
  }

  .newsletter-form__consent a {
    color: inherit;
    text-decoration-thickness: 0.12rem;
    text-underline-offset: 0.18rem;
  }

  .newsletter-form__turnstile {
    width: min(100%, 19rem);
  }

  .newsletter-form__configuration {
    padding: var(--space-2);
    border: 0.12rem solid var(--color-red);
    color: var(--color-red-dark);
    font-weight: 800;
    background: var(--color-paper-highlight);
  }

  .newsletter-form .button {
    width: fit-content;
  }

  .newsletter-form .button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .newsletter-form__status {
    color: var(--color-gray);
    font-family: var(--font-pixel);
    font-size: 0.76rem;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
  }

  @media (min-width: 40rem) {
    .newsletter-form--compact {
      grid-template-columns: 1fr auto;
    }

    .newsletter-form--compact .newsletter-form__consent,
    .newsletter-form--compact .newsletter-form__turnstile,
    .newsletter-form--compact .newsletter-form__configuration,
    .newsletter-form--compact .newsletter-form__status {
      grid-column: 1 / -1;
    }
  }
</style>
