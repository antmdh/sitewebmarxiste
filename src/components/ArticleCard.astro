---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryLabels, localizedDate, type Locale, ui } from '../lib/i18n';
import PixelIcon from './PixelIcon.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  locale: Locale;
}

const { article, locale } = Astro.props;
---

<article class="article-card card">
  {
    article.data.heroImage && (
      <a
        class="article-card__image pixel-image"
        href={`/${locale}/articles/${article.data.slug}/`}
        tabindex="-1"
        aria-hidden="true"
      >
        <Image
          src={article.data.heroImage}
          alt=""
          widths={[320, 480]}
          sizes="(min-width: 70rem) 32vw, (min-width: 44rem) 50vw, 100vw"
          format="webp"
          loading="lazy"
        />
      </a>
    )
  }
  <div class="article-card__body">
    <div class="article-card__meta">
      <a class="tag" href={`/${locale}/articles/categories/${article.data.category}/`}
        >{categoryLabels[locale][article.data.category]}</a
      >
      <time datetime={article.data.publishedAt.toISOString()}
        >{localizedDate(article.data.publishedAt, locale)}</time
      >
    </div>
    <h3><a href={`/${locale}/articles/${article.data.slug}/`}>{article.data.title}</a></h3>
    <p>{article.data.description}</p>
    <a class="article-card__link" href={`/${locale}/articles/${article.data.slug}/`}
      >{ui[locale].read} <PixelIcon name="arrow" size={16} /></a
    >
  </div>
</article>

<style>
  .article-card {
    min-width: 0;
    box-shadow: var(--shadow-hard);
  }

  .article-card__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    border-bottom: 0.19rem solid var(--color-black);
    background: var(--color-charcoal);
  }

  .article-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.2) saturate(0.72) sepia(0.08);
    image-rendering: pixelated;
  }

  .article-card__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    color: var(--color-gray);
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .article-card .tag {
    color: var(--color-white);
    text-decoration: none;
  }

  .article-card h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
  }

  .article-card h3 a {
    text-decoration: none;
  }

  .article-card p {
    color: var(--color-gray);
    font-size: var(--step--1);
  }

  .article-card__link {
    display: inline-flex;
    width: fit-content;
    gap: 0.45rem;
    align-items: center;
    color: var(--color-dark-red);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 900;
    text-transform: uppercase;
  }
</style>
