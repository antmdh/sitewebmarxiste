---
import type { Locale } from '../lib/i18n';
import { locales, ui } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
  locale: Locale;
  translationLinks?: { locale: Locale; href: string }[];
}

const { locale, translationLinks = locales.map((item) => ({ locale: item, href: `/${item}/` })) } =
  Astro.props;
const t = ui[locale];
const navIcons = ['gamepad', 'gear', 'article', 'community', 'info'] as const;
---

<header class="site-header">
  <div class="site-header__inner container">
    <Logo compact />
    <nav class="desktop-nav" aria-label="Navigation principale">
      <ul class="no-list">
        {
          t.nav.map((label, index) => (
            <li>
              <a href={`/${locale}/${t.paths[index]}/`}>
                <PixelIcon name={navIcons[index]} size={16} />
                <span>{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="newsletter-link" href={`/${locale}/newsletter/`}>
        <PixelIcon name="mail" size={16} />
        {t.newsletter}
      </a>
      <a class="discord-link" href="https://discord.gg/placeholder" rel="external">
        <PixelIcon name="community" size={16} />
        {t.discord} ↗
      </a>
      <LanguageSwitcher currentLocale={locale} links={translationLinks} />
      <MobileMenu locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-top: 0.22rem solid var(--color-black);
    border-bottom: 0.28rem solid var(--color-black);
    color: var(--color-black);
    background-color: #c9783f;
    background-image:
      linear-gradient(rgb(246 223 161 / 0.28), rgb(246 223 161 / 0.28)), var(--texture-brick-wall);
    background-size:
      auto,
      48rem auto;
    background-position:
      0 0,
      center;
    background-repeat: repeat;
    box-shadow: inset 0 -0.18rem 0 var(--color-paper-deep);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  .desktop-nav,
  .newsletter-link,
  .discord-link {
    display: none;
  }

  .site-header__actions {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }

  @media (min-width: 62rem) {
    .desktop-nav {
      display: block;
      margin-inline: auto;
    }

    .desktop-nav ul {
      display: flex;
      gap: clamp(0.8rem, 1.6vw, 1.7rem);
    }

    .desktop-nav a,
    .newsletter-link,
    .discord-link {
      font-size: clamp(0.72rem, 0.68rem + 0.12vw, 0.82rem);
      font-family: var(--font-display);
      font-weight: 900;
      letter-spacing: 0.045em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .desktop-nav a {
      display: inline-flex;
      gap: 0.45rem;
      align-items: center;
      padding-block: 1rem;
    }

    .desktop-nav a :global(.pixel-icon) {
      color: var(--color-red);
      filter: drop-shadow(0.08rem 0.08rem 0 var(--color-paper-highlight));
    }

    .desktop-nav a:hover {
      color: var(--color-red);
      text-shadow: 0.08rem 0.08rem 0 var(--color-paper-deep);
    }

    .newsletter-link,
    .discord-link {
      display: inline-flex;
      min-height: 2.6rem;
      gap: 0.45rem;
      align-items: center;
      padding-inline: 0.75rem;
      border: 0.16rem solid var(--color-black);
      box-shadow: 0.18rem 0.18rem 0 var(--color-dark-red);
    }

    .discord-link {
      color: var(--color-white);
      background: var(--color-red);
    }
  }
</style>
