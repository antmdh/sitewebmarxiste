---
type PixelIconName =
  | 'gamepad'
  | 'gear'
  | 'article'
  | 'community'
  | 'info'
  | 'mail'
  | 'arrow'
  | 'monitor'
  | 'quill'
  | 'tools'
  | 'book'
  | 'globe'
  | 'calendar';

interface Props {
  name: PixelIconName;
  size?: number;
  label?: string;
}

const { name, size = 18, label } = Astro.props;

const paths: Record<PixelIconName, string> = {
  gamepad:
    'M4 4h8v1h2v2h1v6h-1v1h-3v-2H5v2H2v-1H1V7h1V5h2V4Zm0 3v1H3v2h1v1h1v-1h1V8H5V7H4Zm6 0H9v2h2V8h1V7h-2Zm2 3h-1v1h1v-1Z',
  gear: 'M6 1h4v2h2v1h2v3h1v3h-1v3h-2v1h-2v1H6v-1H4v-1H2v-3H1V7h1V4h2V3h2V1Zm1 5H6v4h1v1h3v-1h1V7h-1V6H7Zm0 1h3v3H7V7Z',
  article: 'M3 1h8l3 3v11H3V1Zm2 3v1h4V4H5Zm0 3v1h7V7H5Zm0 3v1h7v-1H5Zm0 3v1h5v-1H5Zm7-9h-2V2l2 2Z',
  community: 'M2 2h12v10H8l-3 3v-3H2V2Zm2 3v2h2V5H4Zm3 0v2h2V5H7Zm3 0v2h2V5h-2Z',
  info: 'M5 1h6v1h2v2h2v8h-2v2h-2v1H5v-1H3v-2H1V4h2V2h2V1Zm2 3v2h2V4H7Zm0 3v5h3v-1H9V7H7Z',
  mail: 'M1 3h14v10H1V3Zm2 2v1h1v1h1v1h2v1h2V8h2V7h1V6h1V5h-1v1h-1v1h-1v1H6V7H5V6H4V5H3Z',
  arrow: 'M8 2h3v2h2v2h2v4h-2v2h-2v2H8v-3H1V5h7V2Z',
  monitor:
    'M1 2h14v10h-5v1h3v2H3v-2h3v-1H1V2Zm2 2v6h10V4H3Zm2 2h2v2H5V6Zm4-1h2v1h1v3h-2V8H8V6h1V5Z',
  quill:
    'M12 1h3v3h-1v2h-1v2h-2v2H9v2H7v2H5v1H2v-3h1v-2h2V8h2V6h2V4h2V2h1V1Zm-1 4H9v2H7v2H5v2H4v1h2v-1h2V9h2V7h2V5h-1Z',
  tools: 'M2 1h4v2H5v2h2l6 6v-1h2v4h-1v1h-4v-2h1L5 7H3v2H1V5h1V1Zm9 1h4v4h-1v1h-2l-2 2-2-2 3-3V2Z',
  book: 'M1 2h5l2 2 2-2h5v11h-5l-2 2-2-2H1V2Zm2 2v7h3l1 1V5L5 4H3Zm10 0h-2L9 5v7l1-1h3V4Z',
  globe:
    'M5 1h6v1h2v2h1v2h1v4h-1v2h-1v2h-2v1H5v-1H3v-2H2v-2H1V6h1V4h1V2h2V1Zm1 2H5v2H4v2h3V3H6Zm3 0H8v4h4V5h-1V3H9ZM3 8v2h1v2h2v1h1V8H3Zm5 0v5h1v-1h2v-2h1V8H8Z',
  calendar:
    'M3 1h2v2h6V1h2v2h2v12H1V3h2V1Zm0 5v2h2V6H3Zm4 0v2h2V6H7Zm4 0v2h2V6h-2Zm-8 4v2h2v-2H3Zm4 0v2h2v-2H7Zm4 0v2h2v-2h-2Z',
};
---

<svg
  class="pixel-icon"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  fill-rule="evenodd"
  clip-rule="evenodd"
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={paths[name]}></path>
</svg>

<style>
  .pixel-icon {
    display: inline-block;
    max-width: none;
    flex: 0 0 auto;
    overflow: visible;
    vertical-align: -0.16em;
  }
</style>
