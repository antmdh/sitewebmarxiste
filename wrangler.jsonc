{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitewebmarxiste",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "vars": {
    "GOOGLE_SHEET_RANGE": "subscriptions!A:G",
    "NEWSLETTER_CONSENT_VERSION": "2026-07-26",
  },
  "ratelimits": [
    {
      "name": "NEWSLETTER_RATE_LIMITER",
      "namespace_id": "2026072601",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
